{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doxa-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-12",
  "vars": {
    "ORIGIN_URL": "http://localhost:8786"
  },
  "services": [
    {
      "binding": "AGENT_CONTAINER",
      "service": "doxa-agent-container"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "GENERATION_QUEUE",
        "queue": "doxa-generation-jobs"
      },
      {
        "binding": "EMAIL_QUEUE",
        "queue": "doxa-email-deliveries"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "env": {
    "production": {
      "placement": { "region": "aws:us-east-1" },
      "compatibility_flags": ["global_fetch_strictly_public"],
      "routes": [{ "pattern": "api.doxa.so", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "vars": {},
      "vpc_services": [
        {
          "binding": "ORIGIN",
          "service_id": "${CF_API_ORIGIN_VPC_SERVICE_ID}"
        }
      ],
      "services": [
        {
          "binding": "DOCS_CACHE_INVALIDATOR",
          "service": "doxa-docs-renderer",
          "entrypoint": "DocsHostCache"
        },
        {
          "binding": "AGENT_CONTAINER",
          "service": "doxa-agent-container-production"
        },
        {
          "binding": "PRERENDER_QUEUE",
          "service": "doxa-docs-prerenderer-production",
          "entrypoint": "PrerenderQueue"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "GENERATION_QUEUE",
            "queue": "doxa-generation-jobs"
          },
          {
            "binding": "EMAIL_QUEUE",
            "queue": "doxa-email-deliveries"
          }
        ]
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      }
    }
  }
}
