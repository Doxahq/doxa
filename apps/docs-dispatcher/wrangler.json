{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doxa-docs-renderer",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "cache": {
    "enabled": false,
    "cross_version_cache": true
  },
  "exports": {
    "default": {
      "type": "worker",
      "cache": {
        "enabled": false
      }
    },
    "DocsHostCache": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    },
    "DocsHtmlCache": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    },
    "DocsPrerenderCache": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    },
    "DocsRouteDataCache": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    },
    "DocsRendererCodeCache": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    },
    "DocsTextCache": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    },
    "DocsClientAssetCache": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    }
  },
  "compatibility_date": "2026-06-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "*/*",
      "zone_id": "${CF_DOCS_ZONE_ID}"
    }
  ],
  "assets": {
    "directory": "../docs-template/dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "services": [
    {
      "binding": "DOCS_RESOLVER",
      "service": "doxa-docs-resolver-production"
    },
    {
      "binding": "DOCS_RUNTIME",
      "service": "doxa-docs-runtime-production",
      "entrypoint": "RuntimeSourceApi"
    },
    {
      "binding": "SHARED_RENDERER",
      "service": "doxa-docs-renderer-shared"
    },
    {
      "binding": "PRERENDER_TASKS",
      "service": "doxa-api-production",
      "entrypoint": "PrerenderTaskApi"
    },
    {
      "binding": "TRY_PROXY",
      "service": "doxa-try-proxy",
      "entrypoint": "TryProxyApi"
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "ratelimits": [
    {
      "name": "DOCS_REQUEST_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 3000, "period": 60 }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "DOCS_HOSTNAME_MAP",
      "id": "${CF_DOCS_HOSTNAME_MAP_KV_ID}"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RENDERER_CODE_BUCKET",
      "bucket_name": "doxa-docs-renderer-code"
    },
    {
      "binding": "DOCS_RENDERED_BUCKET",
      "bucket_name": "doxa-docs-rendered-html"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DOCS_WARM_LOCK",
        "class_name": "DocsWarmLock"
      },
      {
        "name": "DOCS_WARM_ANCHOR",
        "class_name": "DocsWarmAnchor"
      },
      {
        "name": "DOCS_REGIONAL_WARMER",
        "class_name": "DocsRegionalWarmer"
      },
      {
        "name": "DOCS_WARM_CONTROL",
        "class_name": "DocsWarmControl"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DocsWarmLock",
        "DocsWarmAnchor",
        "DocsRegionalWarmer",
        "DocsWarmControl"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DOCS_WARM_PUBLISH_QUEUE",
        "queue": "doxa-docs-warm-publish"
      },
      {
        "binding": "DOCS_WARM_SWEEP_QUEUE",
        "queue": "doxa-docs-warm-sweep"
      }
    ],
    "consumers": [
      {
        "queue": "doxa-docs-warm-publish",
        "max_batch_size": 1,
        "max_concurrency": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "doxa-docs-warm-dlq"
      },
      {
        "queue": "doxa-docs-warm-sweep",
        "max_batch_size": 1,
        "max_concurrency": 2,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "doxa-docs-warm-dlq"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "DEBUG": "false",
    "DOXA_PROD_DYNAMIC_RENDERER_MODE": "all",
    "DOXA_PROD_DYNAMIC_RENDERER_SITE_IDS": "",
    "DOXA_RENDERER_BUILD_ID": "unconfigured",
    "DOXA_RENDERER_PACKAGE_KEY": "unconfigured",
    "DOXA_RENDERER_RELEASE_ID": "unconfigured",
    "DOXA_PROD_PRERENDER_MODE": "all",
    "DOXA_PROD_PRERENDER_SITE_IDS": "${OPS_DOCS_PRERENDER_SITE_IDS}",
    "DOXA_PRERENDER_REPAIR_ENABLED": "false",
    "DOXA_PROD_ROUTE_DATA_CACHE_MODE": "all",
    "DOXA_PROD_ROUTE_DATA_CACHE_SITE_IDS": "",
    "DOXA_PROD_SHARED_ISOLATE_MODE": "all",
    "DOXA_PROD_SHARED_ISOLATE_SITE_IDS": "${OPS_DOCS_SHARED_ISOLATE_SITE_IDS}",
    "DOXA_PROD_ROUTE_DATA_PREFETCH_MODE": "all",
    "DOXA_PROD_ROUTE_DATA_PREFETCH_SITE_IDS": "",
    "DOXA_PROD_KV_HOSTNAME_MODE": "on",
    "DOXA_PROD_HTTPS_REDIRECT_MODE": "on",
    "DOXA_PROD_DOCS_CSP_MODE": "enforce",
    "DOXA_PROD_ROUTE_DATA_BROWSER_CACHE_MODE": "all",
    "DOXA_PROD_ROUTE_DATA_BROWSER_CACHE_SITE_IDS": "",
    "DOXA_PROD_TEXT_ROUTE_CACHE_MODE": "all",
    "DOXA_PROD_TEXT_ROUTE_CACHE_SITE_IDS": "",
    "DOXA_PROD_CLIENT_ASSET_FALLBACK_MODE": "on",
    "DOXA_PROD_PREVIOUS_FALLBACK_MODE": "off",
    "DOXA_PREVIOUS_FALLBACK_BUILD_WINDOW_SECONDS": "86400",
    "DOXA_PROD_WARM_MODE": "all",
    "DOXA_PROD_WARM_SITE_IDS": "${OPS_DOCS_WARM_SITE_IDS}",
    "DOXA_PROD_WARM_DEPLOY_SWEEP": "on",
    "DOXA_WARM_MAX_ACTIVE_WARMERS": "24",
    "DOXA_WARM_MAX_ACTIVE_WARMERS_PER_SITE": "4",
    "DOXA_WARM_SWEEP_SITES_PER_TICK": "200",
    "DOXA_WARM_MAX_PAGES": "500",
    "DOXA_WARM_MAX_HOSTNAMES": "3",
    "DOXA_WARM_SITE_FILLS_PER_HOUR": "20000",
    "DOXA_WARM_POOLS": "us-east,eu-west,us-west,asia-ne,singapore,hong-kong,eu-east,oceania",
    "DOXA_PREVIOUS_RENDERER_BUILD_ID": "",
    "DOXA_PREVIOUS_RENDERER_RELEASE_ID": "",
    "DOXA_RENDERER_DEPLOYED_AT": "",
    "VITE_OPENSOURCE_REPO_URL": "https://github.com/ipenywis/doxa",
    "DOXA_API_BASE_URL": "https://api.doxa.so",
    "DOXA_DASHBOARD_BASE_URL": "https://doxa.so",
    "DOXA_DOCS_BASE_DOMAIN": "doxa.page"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
