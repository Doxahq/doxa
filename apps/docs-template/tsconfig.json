{
  "compilerOptions": {
    "target": "ES2022",
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@doxahq/docs-prose": ["../../packages/docs-prose/src/index.ts"],
      "@doxahq/mdx-runtime": ["../../packages/mdx-runtime/src/index.ts"],
      "@doxahq/mdx-runtime/highlight": [
        "../../packages/mdx-runtime/src/highlight/index.ts"
      ],
      "@doxahq/mdx-runtime/highlight-lazy": [
        "../../packages/mdx-runtime/src/highlight/lazy.ts"
      ],
      "@/*": ["./*"],
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "**/*.ts", "**/*.tsx", "vite.config.ts", "worker.js"],
  "exclude": ["node_modules", "dist"]
}
