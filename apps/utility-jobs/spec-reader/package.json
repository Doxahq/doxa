{
  "name": "@doxahq/job-spec-reader",
  "version": "0.1.0",
  "private": true,
  "description": "The spec-reader utility job: reads OpenAPI and Swagger files into neutral spec facts, inside its own container.",
  "type": "module",
  "scripts": {
    "bundle": "node build.mjs",
    "build": "tsc --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && vitest run",
    "test:image": "bash scripts/check-image.sh",
    "image": "docker build -t doxa-spec-reader:dev -f Dockerfile ../../.."
  },
  "dependencies": {
    "@doxahq/contracts": "workspace:*",
    "@doxahq/utility-kit": "workspace:*",
    "@scalar/openapi-upgrader": "0.4.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=26"
  }
}
