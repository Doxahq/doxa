# Security headers of the prerendered pages and static files (SEC-011).
# Keep equal to config/security-headers.js; a test checks it.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'

# Cache rules. A file matches every rule whose path it matches, so these files also get
# the security headers above.
# Vite names each built file after its content, so a new build never reuses a name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The marketing photos keep their names when they change, so the browser keeps a copy for
# an hour, then shows it at once and checks for a new one in the background.
/marketing/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
