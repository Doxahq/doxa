{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doxa-website",
  "logpush": true,
  "main": "worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "compatibility_date": "2025-03-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/",
      "/pricing",
      "/pricing/"
    ]
  }
}
