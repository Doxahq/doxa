# Copy this file to infra/cloudflared/dev.env and fill the values for your
# locally-managed Cloudflare Tunnel.
#
# Keep dev.env private. It points at your local tunnel credentials file.

# Required: UUID of the locally-managed tunnel created by:
# cloudflared tunnel create doxa-local-dev
CLOUDFLARED_TUNNEL_ID=00000000-0000-0000-0000-000000000000

# Optional: defaults to ~/.cloudflared/${CLOUDFLARED_TUNNEL_ID}.json.
# CLOUDFLARED_CREDENTIALS_FILE=/Users/you/.cloudflared/00000000-0000-0000-0000-000000000000.json

# HTTP/2 avoids unstable QUIC latency on some local networks.
CLOUDFLARED_PROTOCOL=http2

# Optional local dev routing defaults.
DOXA_DEV_HOSTNAME=dev.doxa.so
DOXA_WEB_ORIGIN=http://localhost:3001
DOXA_API_ORIGIN=http://localhost:8787
