{
  "name": "doxa-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Private Doxa platform monorepo.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "bash scripts/dev-env.sh",
    "dev:web": "pnpm --filter @doxahq/web dev",
    "dev:api": "pnpm --filter @doxahq/api dev",
    "dev:docs": "pnpm --filter @doxahq/docs-runtime dev",
    "dev:docs-template": "pnpm --filter @doxahq/docs-template dev",
    "dev:tunnel": "bash scripts/dev-tunnel.sh",
    "dev:tunnel:setup": "bash scripts/setup-local-tunnel.sh",
    "dev:tunnel:sync": "node scripts/sync-dev-tunnel-config.mjs",
    "deploy:api": "node scripts/deploy-api.mjs",
    "deploy:docs-resolver": "pnpm --filter @doxahq/api exec wrangler deploy --config wrangler.docs-resolver.json --env production",
    "deploy:agent-container": "pnpm --filter @doxahq/agent-container exec wrangler deploy --env production",
    "deploy:agent-worker": "pnpm --filter @doxahq/agent-worker exec wrangler deploy --env production",
    "deploy:email-worker": "pnpm --filter @doxahq/email-worker exec wrangler deploy --env production",
    "deploy:mcp": "pnpm --filter @doxahq/mcp exec wrangler deploy --env production",
    "deploy:docs-runtime": "pnpm --filter @doxahq/docs-runtime exec wrangler deploy --env production",
    "deploy:docs-template": "pnpm --filter @doxahq/docs-template deploy:renderer",
    "deploy:docs-prerenderer": "pnpm --filter @doxahq/docs-prerenderer exec wrangler deploy --config dist/wrangler.production.json",
    "deploy:web": "VITE_API_BASE_URL=https://api.doxa.so VITE_DOCS_BASE_DOMAIN=doxa.page VITE_DOCS_RENDERER_BASE_URL= VITE_DOCS_RUNTIME_URL=https://preview.doxa.so pnpm --filter @doxahq/web run deploy",
    "deploy:all": "node scripts/deploy-production.mjs",
    "deploy:api:ecs": "node scripts/deploy-api-ecs.mjs",
    "secrets:api:ecs": "bash scripts/api-origin-secrets.sh",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/validate-production-config.test.mjs scripts/docs-placement-config.test.mjs scripts/docs-runtime-config.test.mjs scripts/mcp-production-config.test.mjs scripts/deploy-production.test.mjs scripts/worker-startup.test.mjs scripts/ecs-task-definition.test.mjs scripts/deploy-api-ecs.test.mjs scripts/deploy-api.test.mjs scripts/apply-production-ids.test.mjs scripts/refuse-api-worker-deploy.test.mjs scripts/client-assets-upload.test.mjs scripts/renderer-release-record.test.mjs scripts/dispatcher-warm-config.test.mjs scripts/warm-queue-preflight.test.mjs",
    "validate:production-config": "node scripts/validate-production-config.mjs",
    "test:generation:synthetic": "pnpm --filter @doxahq/agent-container test:synthetic",
    "db:generate": "pnpm --filter @doxahq/db db:generate",
    "db:migrate": "pnpm --filter @doxahq/db db:migrate",
    "db:migrate:node": "pnpm --filter @doxahq/db db:migrate:node",
    "db:migrate:planetscale": "pnpm --filter @doxahq/db db:migrate:planetscale",
    "db:check": "pnpm --filter @doxahq/db db:check",
    "db:local:up": "docker compose up -d postgres",
    "db:local:down": "docker compose down",
    "db:local:migrate": "DATABASE_URL=postgresql://doxa:doxa@localhost:5432/doxa pnpm db:migrate",
    "pack:agent": "pnpm --filter @doxahq/agent pack --dry-run"
  },
  "packageManager": "pnpm@10.33.0"
}
