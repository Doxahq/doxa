{
  "name": "@doxahq/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./orm": "./src/orm.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run tests/client.test.ts && node --test tests/migration-ordering.test.mjs",
    "test:migration": "node --test tests/generation-observability-migration.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:node": "node scripts/migrate-postgres.mjs",
    "db:migrate:planetscale": "DRIZZLE_MIGRATIONS_SCHEMA=public DATABASE_SSL=require node scripts/migrate-postgres.mjs",
    "db:check": "node scripts/check-postgres.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260612.0",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
