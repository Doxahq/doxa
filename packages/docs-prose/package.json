{
  "name": "@doxahq/docs-prose",
  "version": "0.1.0",
  "private": true,
  "description": "Shared prose rendering for Doxa documentation pages: the MDX node renderer, the prose component set, and the article typography.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./icons": "./src/icons/index.ts",
    "./icons/lucide": "./src/icons/lucide.ts",
    "./icons/lucide-tags": "./src/icons/lucide-tags.ts",
    "./styles.css": "./src/styles/prose.css"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:icons": "node scripts/generate-lucide-icons.mjs"
  },
  "dependencies": {
    "@doxahq/mdx-runtime": "workspace:*",
    "@radix-ui/react-tabs": "^1.1.15",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.142",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "lucide-static": "1.55.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
