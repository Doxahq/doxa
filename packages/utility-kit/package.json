{
  "name": "@doxahq/utility-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Runs one utility job in a locked-down Node child process: the supervisor, the job entry and the outcome envelope.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./job": "./src/job-main.ts",
    "./outcome": "./src/outcome.ts",
    "./supervisor": "./src/supervisor.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=26"
  }
}
